# Copy to .env.runtime and replace the endpoint and credentials.
UI_USERNAME=admin
UI_PASSWORD=replace-with-a-strong-password
CONNECTION_TYPE=documentdb
MONGODB_TLS=true
MONGODB_TLS_INSECURE=false
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
MONGODB_TLS_ALLOW_INVALID_HOSTNAMES=false
MONGODB_TLS_CA_FILE=/opt/certs/global-bundle.pem
COMPASS_CONNECTION_NAME=Amazon DocumentDB
MONGODB_HOST=replace-me.cluster-xxxxxxxxxxxx.eu-west-2.docdb.amazonaws.com
MONGODB_USERNAME=replace-me
MONGODB_PASSWORD=replace-me
# Preset defaults: tls=true, bundled AWS CA, authSource=admin,
# replicaSet=rs0, readPreference=secondaryPreferred, retryWrites=false.
# TLS and certificate/hostname verification are mandatory in the DocumentDB profile.
# Other defaults may be overridden for your cluster.
# MONGODB_PASSWORD_FILE=/run/secrets/mongodb_password
