# Copy to .env.runtime. Values are literal: do not add shell quotes or escape $.
# Required browser login (HTTP Basic auth); use a strong password.
UI_USERNAME=admin
UI_PASSWORD=replace-with-a-strong-password

CONNECTION_TYPE=mongodb
COMPASS_CONNECTION_NAME=MongoDB
# Docker Desktop host; use a reachable DNS name for remote MongoDB.
MONGODB_HOST=host.docker.internal
MONGODB_PORT=27017
MONGODB_DATABASE=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# Alternatively set a complete URI (mongodb:// or mongodb+srv://).
# Remove MONGODB_HOST, MONGODB_PORT, and MONGODB_AUTH_SOURCE above unless overriding the URI.
# MONGODB_URI=mongodb+srv://cluster.example.mongodb.net/mydb
# MONGODB_OPTIONS={"appName":"Compass Docker","serverSelectionTimeoutMS":10000}
# MONGODB_TLS=true
# MONGODB_TLS_CA_FILE=/run/certs/ca.pem
# MONGODB_URI_FILE=/run/secrets/mongodb_uri
# MONGODB_PASSWORD_FILE=/run/secrets/mongodb_password
# UI_USERNAME_FILE=/run/secrets/ui_username
# UI_PASSWORD_FILE=/run/secrets/ui_password
# Optional: encrypt manually added connections in the mounted settings directory.
# Set a separate stable password; changing it selects a different encrypted store.
# COMPASS_CONNECTIONS_PASSWORD_FILE=/run/secrets/connection_storage_password
